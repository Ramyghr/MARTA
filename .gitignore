# Holds bcrypt password hashes + session tokens (dashboard/backend/auth_db.py) — unlike
# chat_history.db/paper_trading.db (tracked, existing project practice), this one must
# never land in git regardless of that precedent.
data/auth.db
# dashboard/backend/data/ — stray runtime cache/live-bridge artifacts written from inside
# the docker container when a MARTA_ROOT-anchored path was missing (fixed 2026-09-03).
# The repo-root data/processed/ rule above doesn't cover this nested path (gitignore
# patterns with a mid-pattern "/" anchor to the .gitignore's own directory), which let
# these get git-add -A'd into a commit by accident.
dashboard/backend/data/
encoder/checkpoints/
encoder/plots/
regime/checkpoints/
regime/plots/
rl/checkpoints/
models/
